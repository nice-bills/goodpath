# WalletConnect / Reown — get yours at https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=71dd03d057d89d0af68a4c627ec59694

# Privy — social login + embedded Celo wallet (https://dashboard.privy.io)
# Enable Google + Email in Privy dashboard. Add http://localhost:3000 to allowed origins.
# NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# production | staging | development
NEXT_PUBLIC_GOODDOLLAR_ENV=development

# G$ Path API (pnpm --filter @goodpath/api dev)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Public URL for phone / QR / face-verification callbacks (never use localhost on a phone)
# Set automatically by: pnpm dev:lan  or  pnpm dev:tunnel
# NEXT_PUBLIC_APP_URL=http://192.168.1.10:3000

# Phone via tunnel: pnpm dev:tunnel (sets NEXT_PUBLIC_API_URL=/goodpath-api)

# Judge/demo screenshots without chain (shows sample receipt + path)
# NEXT_PUBLIC_DEMO_MODE=true

# Tip quest — address that receives demo tips (your team wallet)
NEXT_PUBLIC_TIP_RECIPIENT=0x0000000000000000000000000000000000000001

# Minimum tip in G$ (human-readable)
NEXT_PUBLIC_MIN_TIP_G=0.01

# Support quest — GoodCollective pool or team wallet (defaults to tip recipient)
# NEXT_PUBLIC_SUPPORT_RECIPIENT=0xYourPoolOrTeamWallet
# NEXT_PUBLIC_MIN_SUPPORT_G=0.01

# Post-path deploy quest — savings-sdk stake on Celo mainnet
# NEXT_PUBLIC_MIN_DEPLOY_G=0.01

# Superfluid stream (deploy quest — Stream tab)
# NEXT_PUBLIC_STREAM_RECIPIENT=0xYourLeagueJar
# NEXT_PUBLIC_MIN_STREAM_G_PER_MONTH=0.01
